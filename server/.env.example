# =====================================================================
# qingStorClient 更新服务 · 部署配置模板
# ---------------------------------------------------------------------
# 用法：
#   cp .env.example .env
#   按需修改 .env，然后 docker compose up -d
#
# 两个约定：
#   1. .env 不进版本库（.gitignore 已排除），密钥、令牌只放这里。
#   2. 每个变量在 docker-compose.yml 里都有同名默认值（${VAR:-默认}），
#      所以删掉某一行不会导致启动失败，只是回到默认值。
#
# 改完端口后不用改 compose：ports 的映射和容器内的监听值都取自这里。
# =====================================================================

# ---------------------------------------------------------------------
# 监听
# ---------------------------------------------------------------------

# 更新 API 端口（公网侧，给 nginx 反代）。
# 不能和同机其他服务撞：撞了以后监听失败会 process.exit(1)，整个容器起不来。
PORT=8789

# 管理端端口。只发布到宿主机 127.0.0.1，通过 SSH 隧道访问，公网上不存在。
ADMIN_PORT=8790

# 容器内监听地址，必须是 0.0.0.0，否则端口映射进不来。
# 真正的隔离靠 compose 里宿主机侧的 127.0.0.1 绑定 ——
# 改成 127.0.0.1 不会"更安全"，只会让容器直接不可访问。
HOST=0.0.0.0
ADMIN_HOST=0.0.0.0

# ---------------------------------------------------------------------
# 对外访问
# ---------------------------------------------------------------------

# 部署在 nginx 后面时设为 1，否则统计到的 IP 全是 127.0.0.1，
# 按 IP 限流会把所有访客算成同一个人。
TRUST_PROXY=1

# 对外访问前缀，决定 /api/releases/latest 返回的 downloadUrl 形态：
#   填了 → https://你的域名/api/releases/download/12（绝对地址，可直接外发）
#   留空 → /api/releases/download/12（相对路径，由调用方自己拼域名）
#
# 填你自己的更新服务域名，不要填对象存储域名。
# 留空比填错安全：填成占位域名时地址语法完全合法，客户端会安静地
# 去错误域名下载然后 404，排查起来很绕。
PUBLIC_ORIGIN=

# ---------------------------------------------------------------------
# 发布
# ---------------------------------------------------------------------

# 单个安装包上限（MB）。公网侧 nginx 的 client_max_body_size 不影响上传，
# 上传走的是管理端口。
RELEASE_MAX_MB=300

# 客户端未指定渠道时使用的默认渠道。
RELEASE_CHANNEL=stable

# ---------------------------------------------------------------------
# 管理端
# ---------------------------------------------------------------------

# 容器内看到的来源是网桥网关（172.17.0.1 之类），不是回环地址，
# 需要在这里声明受信网段，否则管理端会一律拒绝。
# 这个口子的安全性完全建立在 compose 里 127.0.0.1 的端口绑定上，
# 两条必须成对出现，只留一条等于开洞。
ADMIN_ALLOW_CIDR=172.16.0.0/12

# 管理令牌默认自动生成到 data/admin-token.txt，一般不用在这里指定。
# 想自己定就取消注释（注意别把真实令牌提交进仓库）。
# 取法：docker exec qs-update cat /app/data/admin-token.txt
# ADMIN_TOKEN=

# 设为 1 则整个管理侧不启动（纯公网部署、不开隧道的场景）。
# ADMIN_DISABLED=

# ---------------------------------------------------------------------
# 存储
# ---------------------------------------------------------------------
# 决定**新发布**的包写到哪里：
#   local = 写本地 data/releases（默认，现有部署零改动）
#   s3    = 写对象存储，本地库只记版本元信息，下载时现签一个临时地址
#
# 切换驱动不影响存量包：每条记录自带 storage 字段，按行走各自的驱动。
# 也就是说从 local 切到 s3 之后，之前发在本地盘上的包仍然可以下载；
# 反过来从 s3 切回 local，那些 s3 记录会明确报 503，而不是假装文件丢了。

STORAGE_DRIVER=local

# ---- 以下仅在 STORAGE_DRIVER=s3 时需要 ----

# S3 协议端点，形如 https://s3.<区域>.<服务商域名>，注意开头是 s3.
# 不要填控制台或网页直链用的那个不带 s3 的域名：那是厂商原生 API，
# 只认自家签名格式，AWS SigV4 打过去直接 401。
# 也不能签完再换域名 —— 签名里 Host 参与计算，换域名立刻 SignatureDoesNotMatch。
S3_ENDPOINT=

# 签发下载地址用的公网端点。留空则复用 S3_ENDPOINT。
# 只有「上传走内网地址、下载要走公网域名」时才需要分开填。
S3_PUBLIC_ENDPOINT=

# bucket 名称。
S3_BUCKET=

# 区域。一般就是端点里 s3. 后面那一段（如 zw2 / cn-hangzhou / us-east-1）。
# 签名报 AuthorizationHeaderMalformed 时，先回来检查这里。
S3_REGION=

# 访问密钥。单独建子账号，只授这些权限：
#   s3:PutObject / s3:GetObject / s3:DeleteObject，资源限定到 <bucket>/<前缀>/*
#   s3:ListBucket，用 s3:prefix 条件收窄到同一前缀
# 不要用主账号密钥，也不要给 bucket/* 的全量权限 —— 前缀只能在代码里防手滑，
# 硬隔离必须落在账号层。
S3_ACCESS_KEY=
S3_SECRET_KEY=

# 对象前缀。共用 bucket 时必须填一个独占前缀，免得写到别人的目录里；
# 独占 bucket 也建议保留一层，整齐且以后搬家方便。
# 前缀只存在于服务端，不写进数据库 —— 换 bucket 或换前缀时库不用改数据。
S3_PREFIX=qingstorclient/releases

# 确实要让对象落在 bucket 根，才把这两行一起打开：
# S3_PREFIX=
# S3_ALLOW_ROOT=1

# path-style：bucket 出现在路径里（/bucket/key），而不是子域名（bucket.host/key）。
# 默认 true 且不建议关：多数国内 S3 网关没有 <bucket>.<endpoint> 的泛解析，
# 关掉之后 DNS 都解析不了。
S3_FORCE_PATH_STYLE=true

# 预签名下载地址有效期（秒），默认 300。
# 地址只在收到下载请求的瞬间生成，不写进 downloadUrl，也不进任何缓存。
S3_SIGN_EXPIRES=300
